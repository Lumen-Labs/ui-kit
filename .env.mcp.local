# Copy to .env.mcp.local and fill in. That filename is covered by the
# repository's `.env*` ignore rule; do NOT use .env.production.local here,
# because the root .gitignore force-includes that file and the token would
# be committed.

# Required whenever LUMEN_MCP_HOST is not a loopback address. The server
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUMEN_MCP_TOKEN=870c3534162285c203a2759962767b74

# Bind address. 0.0.0.0 is reachable from other machines; 127.0.0.1 is local
# only and needs no token.
LUMEN_MCP_HOST=0.0.0.0

# 1801 and 1802 are already taken by pipeer and pipeer-website.
LUMEN_MCP_PORT=1803

# Optional hardening. Set these when the server sits behind a proxy or when a
# browser-based client will call it.
# LUMEN_MCP_ALLOWED_HOSTS=mcp.internal,10.0.0.4
# LUMEN_MCP_ALLOWED_ORIGINS=https://studio.example
